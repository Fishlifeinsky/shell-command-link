# 演示1（v0.2）：类型化变量 + 比较表达式 if/else（降级为 ieq + label/jump）
#
# 说明：var int mode = 1 显式类型声明；
#       if (mode == 1) 是原子比较表达式，编译器降级为：
#         ieq mode 1; jump -a L1; <else>; jump L2; label L1; <then>; label L2

var int mode = 1

if (mode == 1) {
    echo("mode ok")
} else {
    echo("mode ng")
}

// 无条件 if{}：沿用当前 G_RETURN（这里 mode==1 为真，跳过 else）
if { } else {
    echo("should-not-print")
}

echo("done")
