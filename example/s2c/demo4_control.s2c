# 演示4（v0.4）：while(标准先判)/break/continue + 位运算/多运算符表达式 + 字符串·flag 状态比较
#
# 语义（编译器降级为 label/jump + 内置运算指令）：
#   while(cond)  标准先判（先判再跑）；continue → 重判条件；break → 退出
#   for 已移除：用 var 初始化 + while 表达（continue 前需自行步进）
#   (i & 1) == 1  条件两侧的算术/位括号
#   st == "busy"  string 状态文本比较（seq）
#   dbg == "-d"   flag 状态比较（seq）

var int total = 0
var int i = 1
while (i <= 10) {
    if ((i & 1) == 1) { i = i + 1; continue }   # 跳过奇数（先步进再 continue）
    if (i > 8) { break }                         # 超过 8 退出
    total = total + i                            # 2+4+6+8 = 20
    i = i + 1
}
echo("even-sum=${total}")

var string st = "idle"
if (st == "busy") { echo(busy) } else { echo(idle-ok) }
st = "busy"

var flag dbg = -d
if (dbg == "-d" && st == "busy") { echo(debug-on) }
