# 演示4（v0.3）：for/break/continue + 位运算/多运算符表达式 + 字符串·flag 状态比较
#
# 语义（编译器降级为 label/jump + 内置运算指令）：
#   for(init;cond;step)  标准 while 先判（先判再跑）
#   continue → 跳到 step；break → 退出循环
#   (i & 1) == 1  条件两侧的算术/位括号
#   st == "busy"  string 状态文本比较（seq）
#   dbg == "-d"   flag 状态比较（seq）

var int total = 0
for (var int i = 1; i <= 10; i = i + 1) {
    if ((i & 1) == 1) { continue }   # 跳过奇数
    if (i > 8) { break }             # 超过 8 退出
    total = total + i                # 2+4+6+8 = 20
}
echo("even-sum=${total}")

var string st = "idle"
if (st == "busy") { echo(busy) } else { echo(idle-ok) }
st = "busy"

var flag dbg = -d
if (dbg == "-d" && st == "busy") { echo(debug-on) }
