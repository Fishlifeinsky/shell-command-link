# =============================================================================
# run_lot.s2c —— 批量老化测试（作为脚本命令：命令行输入 run_lot <件数>）
#   C 侧：主状态机在脚本运行期间推进 b_sim（温度/电机每 tick），并可按下
#   btn 按钮（操作员模拟）；脚本侧负责批次节拍与判定。
#   展示：alias(arg0) / 常量 / 表达式(取模) / while 循环 / if/else 判定 /
#         pwm 升温策略 + 等温 / 电机扫位 / part_pass·part_fail·lot_end 统计。
#   结果由 C 命令副作用累计到 b_lot（C 主状态机可直接读回做混合决策）。
# =============================================================================

# ---- 常量：工艺参数 ----
const int T_WORK  = 60     # 老化目标温度 ℃
const int T_STEP  = 120    # 每件电机扫位步数
const int GAP     = 2      # 件间隔(soak) tick

alias n = arg0             # n = 命令行第 1 参 = 批次件数

# ---- 变量 ----
var int cnt = 0            # 已做件数
var int injected = 0       # 本批注入的不良件数
var int lot_n = ${n}       # 批次容量（把注入参数 arg0 规范为本地 int）

# ================= 1. 开批 + 上电 =================
lot_begin(${lot_n})
power("on")
fan("on")
door("close")
relay(0, "on")             # 加热回路继电器

# ================= 2. 首件升温（批内恒温连续） =================
warm_to(${T_WORK})
b_echo("首件达温")

# ================= 3. 逐件节拍 =================
while (cnt < lot_n) {
    cnt = cnt + 1

    # 3a 治具吸合 + 电机扫位（模拟产品测试动作；m_rel 异步自动到位）
    relay(1, "on")
    m_rel(${T_STEP})
    m_abs(0)
    relay(1, "off")

    # 3b 判定：恒温批内温度恒达标 → 正常应 PASS；每第 3 件注入一次偶发不良，
    #     以同时演示 NG 路径与统计（真实场景由测量结果驱动）。
    if ((cnt % 3) == 0) {
        injected = injected + 1
        part_fail("偶发温度超限")
    } else {
        part_pass()
    }

    # 3c 件间隔（保温维持炉温）
    soak(${GAP})
}

# ================= 4. 汇总（命令侧 b_lot 累计，供 C 读回） =================
lot_end()
b_echo("BATCH-DONE injected=", ${injected})
power("off")
relay(0, "off")
led("off")
buzz(1)
