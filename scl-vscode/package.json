{
  "name": "scl-syntax",
  "displayName": "SCL syntax highlight (.s2c / .chain)",
  "description": "为 shell-command-link 库的两种脚本提供语法高亮：.s2c（现代源）与 .chain（SCL 指令链）。",
  "version": "0.1.1",
  "publisher": "local-dev",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "scl", "s2c", "chain", "shell-command-link", "embedded", "script"
  ],
  "contributes": {
    "languages": [
      {
        "id": "scl-s2c",
        "aliases": [
          "SCL Script",
          "s2c"
        ],
        "extensions": [
          ".s2c"
        ],
        "configuration": "./language-configuration-s2c.json"
      },
      {
        "id": "scl-chain",
        "aliases": [
          "SCL Chain",
          "chain"
        ],
        "extensions": [
          ".chain"
        ],
        "configuration": "./language-configuration-chain.json"
      }
    ],
    "grammars": [
      {
        "language": "scl-s2c",
        "scopeName": "source.scl-s2c",
        "path": "./syntaxes/s2c.tmLanguage.json"
      },
      {
        "language": "scl-chain",
        "scopeName": "source.scl-chain",
        "path": "./syntaxes/chain.tmLanguage.json"
      }
    ]
  }
}
