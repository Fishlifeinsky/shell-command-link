{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SCL Script (s2c)",
  "scopeName": "source.scl-s2c",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#varref" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#function-definitions" },
    { "include": "#function-calls" },
    { "include": "#variable-declarations" },
    { "include": "#alias-definitions" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#identifiers" },
    { "include": "#punctuation" },
    { "include": "#flag" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "match": "#.*$", "name": "comment.line.number-sign.scl-s2c" },
        { "match": "//.*$", "name": "comment.line.double-slash.scl-s2c" },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.scl-s2c"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.scl-s2c",
          "patterns": [{ "include": "#varref" }]
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.scl-s2c",
          "patterns": [{ "include": "#varref" }]
        }
      ]
    },
    "varref": {
      "match": "\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}",
      "name": "variable.other.scl-s2c"
    },
    "numbers": {
      "match": "\\b(0[xX][0-9a-fA-F]+|0[bB][01]+|[0-9]+)\\b",
      "name": "constant.numeric.scl-s2c"
    },
    "types": {
      "match": "\\b(bool|int|flag|string)\\b",
      "name": "storage.type.scl-s2c"
    },
    "function-definitions": {
      "begin": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\(",
      "beginCaptures": {
        "1": { "name": "keyword.control.scl-s2c" },
        "2": { "name": "entity.name.function.scl-s2c" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.parameters.end.scl-s2c" }
      },
      "patterns": [
        { "include": "#parameters" }
      ]
    },
    "parameters": {
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
      "name": "variable.parameter.scl-s2c"
    },
    "function-calls": {
      "match": "\\b(?!if\\b|else\\b|while\\b|do\\b|when\\b|for\\b|fn\\b|ret\\b|var\\b|const\\b|free\\b|cache\\b|break\\b|continue\\b)([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.scl-s2c" }
      }
    },
    "variable-declarations": {
      "match": "\\b(var|const)\\s+(?:(const)\\s+)?(bool|int|flag|string)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.scl-s2c" },
        "2": { "name": "keyword.control.scl-s2c" },
        "3": { "name": "storage.type.scl-s2c" },
        "4": { "name": "variable.other.definition.scl-s2c" }
      }
    },
    "alias-definitions": {
      "match": "\\b(alias)\\s+([A-Za-z_][A-Za-z0-9_]*)(\\s*=\\s*)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.scl-s2c" },
        "2": { "name": "variable.other.definition.scl-s2c" },
        "3": { "name": "keyword.operator.assignment.scl-s2c" },
        "4": { "name": "variable.other.scl-s2c" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(if|else|while|do|when|for|fn|ret|break|continue|var|const|free|alias|cache)\\b",
          "name": "keyword.control.scl-s2c"
        },
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.scl-s2c"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "(==|!=|<=|>=|&&|\\|\\||<<|>>|->)",
          "name": "keyword.operator.scl-s2c"
        },
        {
          "match": "[+\\-*/%&|^~<>=!]",
          "name": "keyword.operator.scl-s2c"
        }
      ]
    },
    "identifiers": {
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
      "name": "variable.other.scl-s2c"
    },
    "punctuation": {
      "match": "[(){}\\[\\],;:]",
      "name": "punctuation.separator.scl-s2c"
    },
    "flag": {
      "match": "\\-[A-Za-z][A-Za-z0-9_]*\\b",
      "name": "constant.other.flag.scl-s2c"
    }
  }
}
